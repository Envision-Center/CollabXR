# IDE-agnostic editor config
# https://editorconfig.org/#example-file
# Other tools like CSharpier may use this for formatting rules
# https://csharpier.com/docs/Configuration#editorconfig

root = true

[*]
indent_style = tab
# indent_size = 4 # Do not specify indent size while using tabs so people can customize editors based on preference
# end_of_line = lf # there is no 'auto' with an .editorconfig

# YAML doesn't support tab whitespace
[*.{yaml,*.yml}]
indent_style = space
indent_size = 4

[*.{cs,csx}]
charset = utf-8
csharpier_formatter = csharp
indent_style = tab
max_line_length = 200
insert_final_newline = true
end_of_line = lf
trim_trailing_whitespace = true

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
